# Openshift
openshift_config_path    = "/Users/mayman/.kcli/clusters/ocp/auth/kubeconfig"
openshift_config_context = "admin"
namespace                = "terraform-enterprise"

# Database
db_chart_repo    = "https://charts.bitnami.com/bitnami"
db_name          = "tfe-db"
db_chart_version = "18.12.4"
db_username      = "tfe"
db_database      = "tfe"
db_storage_class = "lvms-vg1"
db_storage_size  = "8Gi"
db_password      = "Mystrongpassword123!"
# db_password: set via TF_VAR_db_password env var, don't commit it here

# Redis
redis_name          = "tfe-redis"
redis_chart_repo    = "https://charts.bitnami.com/bitnami"
redis_chart_version = "28.3.1"
redis_storage_class = "lvms-vg1"
redis_storage_size  = "8Gi"
redis_password      = "Mystrongpassword123!"
# redis_password: set via TF_VAR_redis_password env var, don't commit it here

# MinIO
minio_name               = "tfe-minio"
minio_chart_repo         = "https://charts.bitnami.com/bitnami"
minio_chart_version      = "17.0.21"
minio_image_repo         = "bitnamilegacy/minio"
minio_console_image_repo = "bitnamilegacy/minio-object-browser"
minio_root_user          = "admin"
minio_bucket             = "tfe"
minio_storage_class      = "lvms-vg1"
minio_storage_size       = "20Gi"
minio_root_password      = "Mystrongpassword123!"
# minio_root_password: set via TF_VAR_minio_root_password env var (min 8 chars), don't commit it here

#ACME 
#acme_server_url         = "https://acme-v02.api.letsencrypt.org/directory"
# acme staging
acme_server_url = "https://acme-staging-v02.api.letsencrypt.org/directory"

cert_email          = "mohamedayman@hotmail.com" # Email for Let's Encrypt expiry notices
tfe_hostname        = "tfe"
domain_name         = "aymantech.net" # your Cloudflare-managed domain
tfe_tls_secret_name = "tfe-certs"

# Cloudflare
cloudflare_account_id = ""         # Cloudflare account ID
cloudflare_api_token  = "" # API token for Cloudflare
# cloudflare_api_token: set via TF_VAR_cloudflare_api_token env var (needs Zone:DNS:Edit on the zone)
cloudflare_tunnel_name = "hetzner-pve"
openshift_ingress_ip   = "10.10.10.6" # kcli ingress VIP on vmbr1

# Rules already on the tunnel; kept because Terraform now owns the full rule list
cloudflare_tunnel_existing_ingress = [
  {
    hostname      = "pve-hetzner.aymantech.net"
    service       = "https://10.10.10.1:8006"
    no_tls_verify = true
  }
]

# Terraform Enterprise
tfe_chart_version       = "2.0.8"
tfe_release             = "2.0.8"
tfe_replica_count       = 1
tfe_license             = "<TFE_LICENSE>" # paste your TFE license string
tfe_encryption_password = "Mystrongpassword123!" # strong random string; keep it, TFE can't decrypt its data without it


